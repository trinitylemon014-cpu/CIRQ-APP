# Copy to .env for local development. NEVER commit the real .env file.
FLASK_ENV=development                 # use "production" on Render
SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
APP_BASE_URL=http://localhost:5000    # on Render: https://your-app.onrender.com

# Supabase (Project Settings -> API). New projects may call these "publishable" and "secret" keys:
# SUPABASE_PUBLISHABLE_KEY / SUPABASE_SECRET_KEY are accepted as aliases for the two keys below.
SUPABASE_URL=https://tphdznnekzxivdbzwczo.supabase.co
SUPABASE_ANON_KEY=sb_publishable_CzSCkY0iYeyLQ0z-Fa233Q_5x4LZRNK
SUPABASE_SERVICE_ROLE_KEY=your-supabase-secret-key-here

# Cloudinary (Dashboard -> API Keys)
CLOUDINARY_CLOUD_NAME= 
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Email (password recovery + email verification). Any SMTP provider works (Brevo, Mailgun, Gmail app password...)
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=CIRQ <no-reply@your-domain.example>

# Safety switches
PAID_COMPETITIONS_ENABLED=false       # master switch for ALL real-money features (paid trivia entry, paid boosts, payer numbers)
AUTO_APPROVE_NEW_ACCOUNTS=false       # false = admin review first, then automatic approval after five minutes
CRON_SECRET=replace-with-another-long-random-secret

# Game / coins / trivia (optional; defaults shown)
DEVELOPER_USERNAME=vex
DEVELOPER_DISPLAY_NAME=VEX
WELCOME_COINS=50
DEV_CARD_COINS=500
DEV_CARD_REWARDS_PER_DAY=1
COIN_BOOST_COST=1000
COIN_BOOST_DAYS=3
TRIVIA_ENTRY_FEE_UGX=1000
TRIVIA_POINTS_PER_COIN=10
BOOST_3D_PRICE_UGX=1000
BOOST_5D_PRICE_UGX=7000
PAYMENT_NUMBER_DISPLAY=0709166004             # the mobile-money number students send to (shown on the Pay page)
PAYMENT_ACCOUNT_NAME=Hannah Musiige

# Upload limits and optional extras
MAX_IMAGE_MB=8
MAX_VIDEO_MB=60
MAX_AUDIO_MB=10
MAX_AUDIO_SECONDS=90
# LIMITER_STORAGE_URI=redis://...     # recommended when running more than one instance
# BLOCKED_TERMS=word1,word2           # extra words for the basic text filter
